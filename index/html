<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Radar de Vagas</title>
<style>
  /* ===== CORES (tema claro e escuro) ===== */
  :root {
    --bg: #f5f4f0;
    --card: #ffffff;
    --ink: #1d1c1a;
    --muted: #6d6961;
    --line: #e3e0d8;
    --accent: #0e6b6b;
    --accent-soft: #e0efee;
    --star: #a86a12;
    --star-soft: #f7ecd9;
    --new: #c2410c;
    --new-soft: #fbe7dc;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #131312;
      --card: #1d1c1a;
      --ink: #ecebe6;
      --muted: #9e998f;
      --line: #2f2d29;
      --accent: #5cc2bd;
      --accent-soft: #17302f;
      --star: #e4ac4f;
      --star-soft: #33281a;
      --new: #fb8c4c;
      --new-soft: #3a2418;
    }
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  .wrap { max-width: 920px; margin: 0 auto; padding: 28px 16px 60px; }

  /* ===== CABEÇALHO ===== */
  header h1 { margin: 0; font-size: 26px; letter-spacing: -0.02em; }
  header p { margin: 4px 0 0; color: var(--muted); font-size: 14px; }

  /* ===== FILTROS ===== */
  .filtros {
    position: sticky; top: 0; z-index: 5;
    background: var(--bg);
    padding: 16px 0 12px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 16px;
  }
  .busca {
    width: 100%;
    padding: 12px 14px;
    font: inherit;
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .busca:focus, select:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .linha { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; align-items: center; }
  select {
    font: inherit; font-size: 14px;
    color: var(--ink); background: var(--card);
    border: 1px solid var(--line); border-radius: 8px;
    padding: 7px 10px;
  }
  .chip {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 14px; cursor: pointer; user-select: none;
    padding: 6px 12px; border-radius: 999px;
    border: 1px solid var(--line); background: var(--card);
  }
  .chip input { accent-color: var(--accent); margin: 0; }
  .contagem { margin-left: auto; color: var(--muted); font-size: 14px; }

  /* ===== CARTÕES DE VAGA ===== */
  .lista { display: grid; gap: 10px; }
  .vaga {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px 16px;
  }
  .vaga.feita { opacity: 0.5; }
  .topo { display: flex; gap: 10px; align-items: flex-start; }
  .vaga h2 { margin: 0; font-size: 16px; line-height: 1.35; flex: 1; }
  .vaga h2 a { color: var(--ink); text-decoration: none; }
  .vaga h2 a:hover { color: var(--accent); text-decoration: underline; }
  .nota {
    font-size: 12px; font-weight: 600; color: var(--muted);
    border: 1px solid var(--line); border-radius: 6px; padding: 1px 7px;
    white-space: nowrap;
  }
  .meta { margin-top: 4px; color: var(--muted); font-size: 14px; }
  .meta strong { color: var(--ink); font-weight: 600; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .tag {
    font-size: 12px; padding: 2px 8px; border-radius: 6px;
    background: var(--accent-soft); color: var(--accent);
  }
  .tag.star { background: var(--star-soft); color: var(--star); }
  .tag.new { background: var(--new-soft); color: var(--new); font-weight: 600; }
  .resumo { margin: 8px 0 0; font-size: 13.5px; color: var(--muted); }
  .acoes { display: flex; gap: 14px; align-items: center; margin-top: 10px; font-size: 14px; }
  .acoes a { color: var(--accent); font-weight: 600; text-decoration: none; }
  .acoes a:hover { text-decoration: underline; }
  .acoes label { display: inline-flex; gap: 6px; align-items: center; cursor: pointer; color: var(--muted); }
  .acoes input { accent-color: var(--accent); }

  .vazio { text-align: center; color: var(--muted); padding: 40px 0; }

  @media (max-width: 560px) {
    .contagem { margin-left: 0; width: 100%; }
    select { flex: 1; }
  }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>🎯 Radar de Vagas</h1>
    <p id="atualizado">Carregando…</p>
  </header>

  <div class="filtros">
    <input id="busca" class="busca" type="search"
           placeholder="Pesquisar cargo, empresa, cidade ou palavra (ex.: commodities)">
    <div class="linha">
      <select id="fonte"><option value="">Todas as fontes</option></select>
      <select id="modelo">
        <option value="">Qualquer modelo</option>
        <option value="remote">🏠 Remoto</option>
        <option value="hybrid">🏢 Híbrido</option>
        <option value="on-site">📍 Presencial</option>
      </select>
      <select id="ordem">
        <option value="nota">Ordenar: maior nota</option>
        <option value="recentes">Ordenar: publicadas recentemente</option>
        <option value="novas">Ordenar: chegaram por último</option>
      </select>
    </div>
    <div class="linha">
      <label class="chip"><input type="checkbox" id="soNovas"> Só novas de hoje</label>
      <label class="chip"><input type="checkbox" id="soEstrela"> Só ⭐ prioritárias</label>
      <label class="chip"><input type="checkbox" id="esconderFeitas"> Esconder as que já me candidatei</label>
      <span class="contagem" id="contagem"></span>
    </div>
  </div>

  <div class="lista" id="lista"></div>
</div>

<script>
// ===== 1. ESTADO =====
let dados = { vagas: [], hoje: "" };
let candidatadas = carregarCandidatadas();

// "Candidatei" fica salvo só neste navegador (localStorage)
function carregarCandidatadas() {
  try { return new Set(JSON.parse(localStorage.getItem("candidatadas") || "[]")); }
  catch (e) { return new Set(); }
}
function salvarCandidatadas() {
  try { localStorage.setItem("candidatadas", JSON.stringify([...candidatadas])); }
  catch (e) { /* navegador sem armazenamento: só não lembra */ }
}

// ===== 2. AJUDANTES =====
const $ = (id) => document.getElementById(id);

function semAcento(txt) {
  return (txt || "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
}
function escapar(txt) {
  return (txt || "").replace(/[&<>"']/g, (c) =>
    ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
}
function linkSeguro(url) {
  return /^https?:\/\//i.test(url || "") ? url : "#";
}
function dataBR(iso) {
  if (!iso) return "";
  const [a, m, d] = iso.split("-");
  return `${d}/${m}`;
}
const MODELOS = { remote: "🏠 Remoto", hybrid: "🏢 Híbrido", "on-site": "📍 Presencial" };

// ===== 3. DESENHAR A LISTA =====
function desenhar() {
  const termo = semAcento($("busca").value.trim());
  const fonte = $("fonte").value;
  const modelo = $("modelo").value;

  let vagas = dados.vagas.filter((v) => {
    if (fonte && v.fonte !== fonte) return false;
    if (modelo && v.modelo !== modelo) return false;
    if ($("soNovas").checked && v.visto_em !== dados.hoje) return false;
    if ($("soEstrela").checked && v.nota < 10) return false;
    if ($("esconderFeitas").checked && candidatadas.has(v.id)) return false;
    if (termo) {
      const texto = semAcento([v.titulo, v.empresa, v.local, v.resumo].join(" "));
      // todas as palavras digitadas precisam aparecer
      if (!termo.split(/\s+/).every((p) => texto.includes(p))) return false;
    }
    return true;
  });

  const ordem = $("ordem").value;
  vagas.sort((a, b) => {
    if (ordem === "recentes") return (b.publicada || "").localeCompare(a.publicada || "");
    if (ordem === "novas") return (b.visto_em || "").localeCompare(a.visto_em || "") || b.nota - a.nota;
    return b.nota - a.nota;
  });

  $("contagem").textContent = `${vagas.length} de ${dados.vagas.length} vagas`;

  if (!vagas.length) {
    $("lista").innerHTML = `<p class="vazio">Nenhuma vaga com esses filtros.</p>`;
    return;
  }

  $("lista").innerHTML = vagas.map((v) => {
    const feita = candidatadas.has(v.id);
    const tags = [];
    if (v.visto_em === dados.hoje) tags.push(`<span class="tag new">NOVA</span>`);
    if (v.nota >= 10) tags.push(`<span class="tag star">⭐ prioritária</span>`);
    if (MODELOS[v.modelo]) tags.push(`<span class="tag">${MODELOS[v.modelo]}</span>`);
    tags.push(`<span class="tag">${escapar(v.fonte)}</span>`);
    if (v.publicada) tags.push(`<span class="tag">publicada ${dataBR(v.publicada)}</span>`);

    return `
      <article class="vaga ${feita ? "feita" : ""}">
        <div class="topo">
          <h2><a href="${escapar(linkSeguro(v.link))}" target="_blank" rel="noopener">${escapar(v.titulo)}</a></h2>
          <span class="nota" title="Nota do robô">${v.nota} pts</span>
        </div>
        <div class="meta"><strong>${escapar(v.empresa) || "Empresa não informada"}</strong>${v.local ? " · " + escapar(v.local) : ""}</div>
        <div class="tags">${tags.join("")}</div>
        ${v.resumo ? `<p class="resumo">${escapar(v.resumo.slice(0, 220))}${v.resumo.length > 220 ? "…" : ""}</p>` : ""}
        <div class="acoes">
          <a href="${escapar(linkSeguro(v.link))}" target="_blank" rel="noopener">Abrir vaga ↗</a>
          <label><input type="checkbox" data-id="${escapar(v.id)}" ${feita ? "checked" : ""}> Candidatei</label>
        </div>
      </article>`;
  }).join("");
}

// ===== 4. CARREGAR O ARQUIVO DO ROBÔ =====
async function carregar() {
  try {
    const r = await fetch("vagas.json?t=" + Date.now());   // ?t= evita versão velha em cache
    dados = await r.json();
  } catch (e) {
    $("atualizado").textContent = "Não consegui carregar o vagas.json. O robô já rodou?";
    return;
  }
  $("atualizado").textContent =
    `Atualizado em ${dados.atualizado_em} · ${dados.vagas.length} vagas no radar`;

  const fontes = [...new Set(dados.vagas.map((v) => v.fonte))].sort();
  $("fonte").innerHTML += fontes.map((f) => `<option>${escapar(f)}</option>`).join("");
  desenhar();
}

// ===== 5. REAGIR AOS CLIQUES E À DIGITAÇÃO =====
["busca", "fonte", "modelo", "ordem", "soNovas", "soEstrela", "esconderFeitas"]
  .forEach((id) => $(id).addEventListener("input", desenhar));

$("lista").addEventListener("change", (e) => {
  const id = e.target.dataset.id;
  if (!id) return;
  e.target.checked ? candidatadas.add(id) : candidatadas.delete(id);
  salvarCandidatadas();
  desenhar();
});

carregar();
</script>
</body>
</html>
